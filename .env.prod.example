# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -base64 32

# Domain with A/AAAA records pointing at this server (Caddy gets a TLS cert).
DOMAIN=example.com

# Postgres (internal only — not exposed outside the compose network).
DB_NAME=sparks
DB_USER=sparks
DB_PASSWORD=change-me

# API auth.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Allowed browser origin — your site over https.
CORS_ORIGIN=https://example.com
