# Copy to .env and fill in. Never commit the real .env.
# Generate secrets with:  openssl rand -base64 32

# Domain with A/AAAA records pointing at this server (Caddy gets a TLS cert).
DOMAIN=example.com

# Where the web container proxies /api. Default (compose): the internal
# `server:8081`. Set only if the backend is elsewhere (e.g. host.docker.internal:8081).
# API_UPSTREAM=server:8081

# Postgres (internal only — not exposed outside the compose network).
DB_NAME=sparks
DB_USER=sparks
DB_PASSWORD=change-me

# API auth.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Allowed browser origin — your site over https.
CORS_ORIGIN=https://example.com

# Таймзона лагеря: в ней разбирается «настенное» время раскрытия составов КТБ.
# Сервер в UTC — зона задаётся явно.
SPARKS_TIMEZONE=Asia/Novosibirsk
